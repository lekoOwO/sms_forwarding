+static constexpr size_t HTTP_REQUEST_LINE_LIMIT = 2048;
+static constexpr size_t HTTP_HEADER_LIMIT = 8192;
+static constexpr size_t HTTP_BODY_LIMIT = 16384;
+
+static bool rejectRequest(NetworkClient &client, int status, const char *reason) {
+  client.printf("HTTP/1.1 %d %s\r\nConnection: close\r\nCache-Control: no-store\r\nContent-Length: 0\r\n\r\n", status, reason);
+  client.stop();
+  return false;
+}
+
+static bool readHttpLine(NetworkClient &client, String &line, size_t maxBytes, int status, const char *reason) {
+  line = "";
+  unsigned long start = millis();
+  while (client.connected() && millis() - start < HTTP_MAX_DATA_WAIT) {
+    int value = client.read();
+    if (value < 0) {
+      delay(1);
+      continue;
+    }
+    if (value == '\n') return true;
+    if (value == '\r') {
+      while (client.connected() && millis() - start < HTTP_MAX_DATA_WAIT) {
+        value = client.read();
+        if (value == '\n') return true;
+        if (value >= 0) return false;
+        delay(1);
+      }
+      return false;
+    }
+    if (line.length() >= maxBytes) return rejectRequest(client, status, reason);
+    line += (char)value;
+  }
+  return false;
+}
+
+static bool parseContentLength(const String &value, size_t &length) {
+  if (value.isEmpty()) return false;
+  length = 0;
+  for (size_t i = 0; i < value.length(); ++i) {
+    char digit = value[i];
+    if (digit < '0' || digit > '9') return false;
+    size_t next = digit - '0';
+    if (length > (HTTP_BODY_LIMIT - next) / 10) return false;
+    length = length * 10 + next;
+  }
+  return true;
+}
