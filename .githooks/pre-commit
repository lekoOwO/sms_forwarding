#!/bin/sh
set -eu

root=$(git rev-parse --show-toplevel)
cd "$root"

if [ "$(git branch --show-current)" != "develop" ]; then
  python3 scripts/generate-firmware-version.py --check
  exit
fi

if git diff --cached --quiet -- firmware-version.json; then
  python3 scripts/generate-firmware-version.py --bump
else
  python3 scripts/generate-firmware-version.py
fi
git add -- firmware-version.json code/firmware_version_generated.h
